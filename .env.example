# Environment variables for SpendWise
# Copy to .env and fill in your values.
# NEVER commit .env to git.

# ---- Flask ----
# REQUIRED: change this to a long random string in production
SECRET_KEY=replace-me-with-a-long-random-secret-key

# ---- Database ----
# Local development: leave blank to use SQLite (auto-configured)
# Production: set to your PostgreSQL URL
#   e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# ---- Flask environment ----
# Use 'development' locally, 'production' on Vercel
FLASK_ENV=development

# ---- File storage ----
# 'local' = store uploads in instance/uploads/ (dev only)
# 's3'    = S3-compatible storage (production)
STORAGE_PROVIDER=local

# S3 / Cloudflare R2 settings (only needed if STORAGE_PROVIDER=s3)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# For Cloudflare R2: STORAGE_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
