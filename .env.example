# =====================================================================
# PennyWise — Environment Configuration Template
# CS50x 2026 Final Project
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =====================================================================

# ---- Flask Security ----
# Cryptographic secret key for session cookies and CSRF tokens
SECRET_KEY=generate-a-secure-random-64-character-hex-string

# ---- Database ----
# SQLite local development default (leave blank for local instance/pennywise.db):
# DATABASE_URL=sqlite:///instance/pennywise.db
#
# Production / Supabase PostgreSQL:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# ---- Application Environment ----
# Options: development, production, testing
FLASK_ENV=development

# ---- Google OAuth 2.0 (Google Sign-In) ----
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- File Storage ----
# Options: local, s3
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT_URL=
